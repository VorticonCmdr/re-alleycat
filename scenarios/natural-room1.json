    "file": "CAT.EXE",
    "sha256": "4979c8867826e08881d1d4bec95c95d6bc1ac70fd21050ccdb4f733a50d7bfdd"
  },
  "emulator": {
    "name": "dosbox-automation",
    "machine": "svga_s3",
    "cpu_cycles": 3000,
    "core": "auto",
    "launch": "C:\\CAT.EXE from the shell, C: = game/ (read-only), PSP 01E5"
  },
  "startState": "program entry CS:0000 after a clean launch; environment values come from the capture stream",
  "keyInjection": "at sync points, by writing the memory effects of the game INT 9 handler (CS:14b3)",
  "stateInjection": "room choice only (DS:0421-0431, 041d-0420, 0551 at alley pass 60); the room goal is reached by play",

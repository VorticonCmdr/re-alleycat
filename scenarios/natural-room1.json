    "vram": "0000..4000",
    "dsExclude": [
      {
        "from": "5a0e",
        "to": "5a10",
        "reason": "CS:5ac2 stores a PIT ch0 sample (sound timing only)"
      },
      {
        "from": "5a12",
        "to": "5a14",
        "reason": "CS:5ac2 sweep value advanced per PIT-timed step (sound only)"
      },
      {
        "from": "5a16",
        "to": "5a1a",
        "reason": "CS:5a1c PIT sample and retune counter (sound only)"
      },
      {
        "from": "5a3c",
        "to": "5a40",
        "reason": "CS:5a1c sweep accumulators advanced per PIT-timed retune (sound only)"
      }
    ]
  },
  "verify": "npm run verify -- --only=reference   (single: node tests/reference.mjs --scenario=natural-room1)",
  "maxTicks": 6000,
